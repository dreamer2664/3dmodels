# A themed pack: small hard-surface props for filling out a game/archviz scene.
# Generate briefs from it with:
#   python tools/brief_from_pack.py packs/basic-props.pack --list
#   python tools/brief_from_pack.py packs/basic-props.pack --count 2
# Items already generated are never duplicated.

pack: basic-props
category: hard-surface-prop
style: stylised-realistic

defaults:
  tri_budget: 15000-60000
  min_renders: 5
  min_render_px: 1600
  deliverables: "[glb, blend, renders, zip, readme]"
  references:
    - "collectible / museum photography of the object for proportion and construction"
    - "if it is a real product, look at how it is assembled, not at one brand's logo"

items:
  - slug: brass-portable-lantern
    title: Brass Portable Lantern
    dimensions_m: {x: 0.162, y: 0.162, z: 0.312}
    tri_budget: 20000-80000
    must_have:
      - flared spun-brass base reservoir with a rolled seam
      - domed vent cap with louvred slots and a small lifting loop
      - four vertical guard wires protecting the glass globe
      - hinged side door with a visible hinge pin
      - wire bail handle as a separate object, pivoting on two rivets
      - wick adjuster knob with knurling on the right side
    avoid:
      - soot or heavy damage on the glass
      - legible branding or maker's marks
      - a lit flame (this is an unlit asset)
    acceptance:
      - the glass globe reads as glass, not as grey plastic
      - the bail handle can be rotated without intersecting the vent cap
    parts:
      - base reservoir — spun brass, patinated
      - filler cap with leather gasket
      - burner collar with four air vents
      - glass globe — soda-lime, faint green tint
      - four guard wires — drawn brass
      - side door with hinge pin
      - vent cap with louvres and loop
      - bail handle — 2.5 mm brass wire
    notes: >
      A generic late-19th-century kerosene hand lantern, the sort carried by railway workers and
      farmhands. Reconstruct the common pattern rather than a specific surviving object. Proportion
      matters more than ornament: the reservoir should read as the heaviest mass and the glass as
      the visual void.

  - slug: cast-iron-skillet
    title: Cast Iron Skillet
    dimensions_m: {x: 0.32, y: 0.28, z: 0.06}
    must_have:
      - pour spouts on both sides of the rim
      - helper handle opposite the main handle
      - seasoning patina with uneven sheen
      - casting texture on the underside
    avoid:
      - food residue or oil pools
      - chipped enamel (this is bare cast iron)
    acceptance:
      - the rim thickness reads correctly at the macro shot
    parts:
      - pan body — cast iron, seasoned
      - main handle with a hanging hole
      - helper handle

  - slug: ceramic-teapot
    title: Stoneware Teapot
    dimensions_m: {x: 0.24, y: 0.16, z: 0.15}
    tri_budget: 25000-90000
    must_have:
      - a lid that seats into the body with a visible seam
      - a hand-pulled spout with a clean opening
      - a cane handle bound to two lugs
      - subtle throwing rings on the body
    avoid:
      - a glossy porcelain look (this is matte stoneware)
      - a full tea set
    parts:
      - body — matte stoneware, celadon glaze
      - lid with a knob
      - spout
      - cane handle with bindings

  - slug: wooden-crate
    title: Slatted Wooden Crate
    dimensions_m: {x: 0.50, y: 0.36, z: 0.28}
    must_have:
      - visible nail heads on the corner battens
      - uneven slat thickness and spacing
      - a stencilled marking, deliberately illegible
    avoid:
      - perfectly uniform planks
      - readable brand names
    parts:
      - slats — pine, weathered
      - corner battens
      - nails — dark steel
