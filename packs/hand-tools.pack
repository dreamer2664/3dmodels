# Second pack: hand tools. Wood + steel + a working finish.
#   python tools/brief_from_pack.py packs/hand-tools.pack --count 1

pack: hand-tools
category: hard-surface-prop
style: stylised-realistic

defaults:
  tri_budget: 20000-80000
  min_renders: 5
  min_render_px: 1600
  deliverables: "[glb, blend, renders, zip, readme]"

items:
  - slug: wooden-jointer-plane
    title: Wooden Jointer Plane
    dimensions_m: {x: 0.60, y: 0.08, z: 0.14}
    tri_budget: 30000-100000
    must_have:
      - a wedged iron with a visible chip breaker
      - a mouth opening that reads correctly at macro distance
      - rosewood handles turned and fitted, not merged into the body
      - wear polish on the sole edges where hands and the bench touch
    avoid:
      - a metal-bodied plane (this is a wooden plane)
      - shavings or sawdust piles
    acceptance:
      - the iron, wedge and body read as three separate parts
    parts:
      - body — beech, worn
      - iron and chip breaker — steel
      - wedge — oak
      - front knob and rear tote — rosewood

  - slug: machinist-hammer
    title: Ball Peen Machinist Hammer
    dimensions_m: {x: 0.34, y: 0.12, z: 0.04}
    must_have:
      - a wedge visible in the eye of the head
      - cross-hatched knurling on the handle end
      - forged texture with a chamfered face edge
    avoid:
      - a claw hammer silhouette
      - chewed or splintered handle wood
    parts:
      - head — forged steel, dark
      - handle — hickory
      - steel wedge

  - slug: hand-drill-brace
    title: Bit Brace Hand Drill
    dimensions_m: {x: 0.36, y: 0.22, z: 0.14}
    tri_budget: 35000-120000
    must_have:
      - a two-jaw chuck with a visible knurled sleeve
      - a rotating head with a bearing collar
      - a swept crank with a wooden wrist handle
      - a wood-screw shank in the chuck
    avoid:
      - modern cordless-drill forms
      - a missing bit
    parts:
      - frame — japanned iron
      - cocobolo head and wrist handle
      - chuck jaws and sleeve — steel
      - wood screw bit

  - slug: spirit-level
    title: Brass Spirit Level
    dimensions_m: {x: 0.46, y: 0.06, z: 0.05}
    must_have:
      - two vials at different orientations with liquid meniscus visible
      - a brass frame with machined ribbing
      - wear at the corners where it has been set down
    avoid:
      - a plastic body
      - empty vials (the liquid and bubble must be modelled or shaded)
    parts:
      - frame — brass
      - vial bodies — glass
      - vial liquid and bubble
      - end caps
