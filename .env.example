# .env.example — copy to .env (never commit .env; it is git-ignored)
#
# The repository owner has placed a placeholder for the GitHub PAT and grants explicit
# permission for agents working in this repository to use it to push their work.
#
# Replace <PASTE_PAT_HERE> with the token you were given. Do not commit the real value.
# Do not paste the real value into a README, a PR body, a render, or a commit message.

# Fine-grained PAT for github.com/dreamer2664/3dmodels
# Required permission: Contents -> Read and write  (Pull requests -> Read and write is optional)
GH_TOKEN=<PASTE_PAT_HERE>

# Who is pushing (used for git commit author + workspace naming)
GIT_AUTHOR_NAME=dreamer2664
GIT_AUTHOR_EMAIL=dreamer2664@users.noreply.github.com
GIT_REMOTE_OWNER=dreamer2664
GIT_REMOTE_REPO=3dmodels

# Where to install Blender (tools/setup_blender.sh)
BLENDER_PREFIX=$HOME/.local/blender
BLENDER_VERSION=4.2.23
BLENDER_CHANNEL=Blender4.2
